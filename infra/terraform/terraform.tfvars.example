# Copie este arquivo para terraform.tfvars e preencha os valores.
# Nunca commite o terraform.tfvars — ele contém credenciais sensíveis.
#
#   cp terraform.tfvars.example terraform.tfvars

# -----------------------------------------------------------------------------
# Banco de dados (RDS PostgreSQL)
# -----------------------------------------------------------------------------
db_password = "troque-por-uma-senha-forte"

# -----------------------------------------------------------------------------
# E-mail (Gmail — use uma Senha de App, não a senha da conta)
# https://myaccount.google.com/apppasswords
# -----------------------------------------------------------------------------
mail_username = "seu-email@gmail.com"
mail_password = "xxxx xxxx xxxx xxxx"

# -----------------------------------------------------------------------------
# Credenciais AWS — NÃO definir aqui
# -----------------------------------------------------------------------------
# aws_access_key_id, aws_secret_access_key e aws_session_token são injetadas
# automaticamente via TF_VAR_ pelo apply.sh (ou pelos secrets do GitHub Actions).
# Expiram a cada sessão do AWS Academy — nunca commitar.
